#!/bin/sh
# desk-session-helper JOB -- the parts of a desktop session DEsk does
# not draw, each started from an autostart entry of DEsk's own
# (session/autostart, OnlyShowIn=DEsk) with whichever free program for it
# is installed. Nothing here is DEsk's own code; it only picks.
#
#   polkit    the agent that asks for a password when something needs one
#             (mounting a disk, joining a network, the power buttons)
#   keyring   the store programs keep passwords in (the Secret Service)
#   ime       the input method, for typing Japanese and the like
#   ime-kind  which input method this session wants: ibus, fcitx, or
#             nothing (desk-session asks, before it sets things up)
#   network   the network applet, in the tray
#   media     memory sticks and disks: mounted when put in, a letter saying
#             so, and a slip in the tray while there is one to take out
#   power     a letter when the battery runs low
#   scale S   programs' text as big as the desk's own things, S pixels to a
#             point (DEsk, at the start of its session): GTK's text scale in
#             DEsk's own layer of settings, never over one the user set
#   end NAME  the session is over (desk-session, once DEsk has gone): what it
#             told systemd is taken back, and the portals it started stopped,
#             while systemd's XDG_CURRENT_DESKTOP is still NAME (DEsk)
set -u

# An input method is started only where there is something for it to do:
# a language typed through one (Japanese, Chinese, Korean, Vietnamese,
# Thai), or an engine the user has set up -- IBus's list holds more than
# keyboards. Most of the world types what is on its keys, and has no use
# for one in the tray.
ime_kind() {
	case "${GTK_IM_MODULE:-}${QT_IM_MODULE:-}" in
	*fcitx*)
		command -v fcitx5 >/dev/null 2>&1 && { echo fcitx; return; }
		;;
	esac
	want=
	case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
	ja*|zh*|ko*|vi*|th*) want=1 ;;
	esac
	if command -v ibus-daemon >/dev/null 2>&1; then
		if [ -z "$want" ] && command -v gsettings >/dev/null 2>&1 \
			&& gsettings get org.freedesktop.ibus.general preload-engines 2>/dev/null \
				| tr ',' '\n' | grep -q "'[^x'][^']*'\|'x[^k][^']*'"; then
			want=1
		fi
		[ -n "$want" ] && echo ibus
		return 0
	fi
	if [ -n "$want" ] && command -v fcitx5 >/dev/null 2>&1; then
		echo fcitx
	fi
	return 0   # none wanted is an answer too, not a failure
}

first() {
	for p in "$@"; do
		case "$p" in
		/*) [ -x "$p" ] && { echo "$p"; return 0; } ;;
		*) command -v "$p" >/dev/null 2>&1 && { command -v "$p"; return 0; } ;;
		esac
	done
	return 1
}

case "${1:-}" in
end)
	# What DEsk's session told systemd and D-Bus for the programs they
	# start (session.c's ACTIVATION_VARS) is taken back, and the portals
	# started for it are stopped: left, the next desktop this user logs in
	# to while systemd is still running would start its services with
	# DEsk's display, which is gone, and get DEsk's portals, pointed at it.
	# Only while systemd's environment is still this session's: a desktop
	# set up since (a second login) has made it its own.
	name=${2:-DEsk}
	command -v systemctl >/dev/null 2>&1 || exit 0
	env=$(timeout 5 systemctl --user show-environment 2>/dev/null) || exit 0
	printf '%s\n' "$env" | grep -qxF "XDG_CURRENT_DESKTOP=$name" || exit 0
	timeout 10 systemctl --user stop xdg-desktop-portal-wlr.service \
		xdg-desktop-portal-gtk.service xdg-desktop-portal.service >/dev/null 2>&1 || true
	timeout 5 systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY \
		XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP DESKTOP_SESSION \
		QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME GDK_BACKEND MOZ_ENABLE_WAYLAND \
		GTK_IM_MODULE QT_IM_MODULE QT_IM_MODULES XMODIFIERS DESK_IM \
		XCURSOR_THEME XCURSOR_SIZE DCONF_PROFILE QT_SCALE_FACTOR >/dev/null 2>&1 || true
	echo "desk-session-helper: the session's environment and portals taken back"
	exit 0
	;;
polkit)
	# A small GTK window asking for the password, as the rest of the
	# standard set is: MATE's, Xfce's (xfce-polkit), LXDE's, GNOME's old
	# one; KDE's and LXQt's after them. Where each distribution puts it:
	# Debian and Ubuntu in /usr/libexec or a multiarch libexec, Arch in
	# /usr/lib/<package>.
	agent=$(first \
		/usr/libexec/polkit-mate-authentication-agent-1 \
		/usr/lib/mate-polkit/polkit-mate-authentication-agent-1 \
		/usr/libexec/xfce-polkit \
		/usr/lib/xfce-polkit/xfce-polkit \
		lxpolkit \
		/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
		/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
		/usr/libexec/polkit-gnome-authentication-agent-1 \
		/usr/lib/*/libexec/polkit-kde-authentication-agent-1 \
		/usr/libexec/polkit-kde-authentication-agent-1 \
		/usr/libexec/kf6/polkit-kde-authentication-agent-1 \
		/usr/lib/polkit-kde-authentication-agent-1 \
		lxqt-policykit-agent \
		/usr/libexec/hyprpolkitagent) || exit 0
	exec "$agent"
	;;
keyring)
	command -v gnome-keyring-daemon >/dev/null 2>&1 || exit 0
	# already unlocked at login by the display manager's PAM, if it is set
	# up for that; started here otherwise, locked until first used
	exec gnome-keyring-daemon --start --components=secrets,pkcs11 >/dev/null
	;;
ime-kind)
	ime_kind
	;;
ime)
	# the one desk-session told programs to use (its own tray item,
	# fcitx5's, is in the tray already)
	case "${DESK_IM:-$(ime_kind)}" in
	fcitx)
		command -v fcitx5 >/dev/null 2>&1 && exec fcitx5 -d
		;;
	ibus)
		# One per session: a second one finds the first on the bus and
		# goes. Its panel puts itself in the tray (a StatusNotifierItem,
		# with the engines and the input modes in its menu) only for a
		# desktop it takes for KDE; for any other it makes an X tray
		# icon, which DEsk has nowhere to put. This desktop's tray is
		# one of the same kind as KDE's.
		# Its panel shows the candidates -- Mozc's too, which in a
		# Wayland session gives up its own window for IBus's -- and
		# through X where there is an X: an X window can say where it
		# goes, so they come up under the text being written, from a
		# Wayland program (DEsk tells IBus where its cursor is) and
		# from an X one (XIM does); a Wayland window cannot, and DEsk
		# puts it there itself (wm.c, ime_window_is).
		GDK_BACKEND=x11,wayland XDG_CURRENT_DESKTOP=KDE exec ibus-daemon --daemonize --xim
		;;
	esac
	;;
network)
	command -v nm-applet >/dev/null 2>&1 || exit 0
	# the form that sits in a StatusNotifierItem tray, which DEsk's is
	exec nm-applet --indicator
	;;
media)
	command -v udiskie >/dev/null 2>&1 || exit 0
	# its slip shows only while something is mounted; on Wayland it is an
	# AppIndicator one (a StatusNotifierItem), which this tray shows, and
	# without the indicator library udiskie goes on without a slip
	exec udiskie --automount --notify --smart-tray
	;;
power)
	# poweralertd asks UPower, and says nothing of how things stood when
	# it started (-s); its own systemd unit waits on graphical-session.target,
	# which nothing in a DEsk session starts. batsignal (Arch) reads the
	# batteries itself.
	if command -v poweralertd >/dev/null 2>&1; then
		exec poweralertd -s
	fi
	command -v batsignal >/dev/null 2>&1 || exit 0
	exec batsignal
	;;
scale)
	# On a screen where a point is more than a pixel the desk draws its own
	# things bigger, but programs are told no scale, so GTK's text is made
	# as big through org.gnome.desktop.interface text-scaling-factor, which
	# GTK 3 and 4 (and Firefox through them) read, and follow as it
	# changes. Only in DEsk's own layer of settings (desk-dconf-profile,
	# which desk-session sets): never in the user's, where another desktop
	# would get it too. A scale someone set -- here or in another desktop --
	# is theirs, and left; the one given here is noted, so that it can be
	# changed with the screen, or taken back on an ordinary one.
	s=${2:-1}
	case "$s" in
	''|*[!0-9.]*) echo "desk-session-helper: scale wants a number, not $s" >&2; exit 2 ;;
	esac
	case "${DCONF_PROFILE:-}" in
	'') exit 0 ;;
	esac
	grep -qx 'user-db:desk' "$DCONF_PROFILE" 2>/dev/null || exit 0
	command -v dconf >/dev/null 2>&1 || exit 0
	key=/org/gnome/desktop/interface/text-scaling-factor
	given="${XDG_STATE_HOME:-$HOME/.local/state}/desk/text-scale-given"
	now=$(dconf read "$key" 2>/dev/null)
	mine=$(cat "$given" 2>/dev/null)
	if [ -n "$now" ] && [ "$now" != "$mine" ]; then
		echo "desk-session-helper: GTK's text scale is $now, set by the user: left as it is"
		exit 0
	fi
	# 1 or less: an ordinary screen, and what was given for another taken back
	if awk -v s="$s" 'BEGIN { exit !(s <= 1.001) }'; then
		if [ -n "$mine" ]; then
			dconf reset "$key" 2>/dev/null || true
			rm -f "$given"
			echo "desk-session-helper: GTK's text scale taken back (an ordinary screen)"
		fi
		exit 0
	fi
	# a double, as the key is one ("2" alone would be an integer, and refused)
	v=$(awk -v s="$s" 'BEGIN { printf "%.2f", s }')
	dconf write "$key" "$v" || exit 0
	mkdir -p "$(dirname "$given")"
	dconf read "$key" > "$given"
	echo "desk-session-helper: GTK's text scale $v, as the desk's (a point is $s pixels)"
	exit 0
	;;
*)
	echo "usage: desk-session-helper polkit|keyring|ime|ime-kind|network|media|power|scale S" >&2
	exit 2
	;;
esac
